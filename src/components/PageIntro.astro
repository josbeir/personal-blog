---
interface Props {
  title: string;
  eyebrow: string;
  intro: string;
}

const { title, eyebrow, intro } = Astro.props;
const paragraphs = intro.split('\n\n');
---

<section class="relative left-1/2 -mt-6 mb-12 w-screen -translate-x-1/2 overflow-hidden border-y border-base-content/10 bg-base-200 lg:-mt-10 lg:mb-16">
  <div class="pointer-events-none absolute -right-20 top-[-9rem] h-80 w-80 rounded-full border border-primary/20"></div>
  <div class="pointer-events-none absolute bottom-[-7rem] left-[38%] h-56 w-56 rounded-full border border-base-content/10"></div>

  <div class="relative mx-auto max-w-7xl px-6 py-14 lg:px-10 lg:py-18">
    <div class="grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
      <div>
        <p class="mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-primary">{eyebrow}</p>
        <h1 class="max-w-3xl text-5xl font-bold leading-[0.95] tracking-tight md:text-6xl">{title}</h1>
      </div>

      <div class="border-l-2 border-primary/45 pl-5 md:pl-7">
        {paragraphs.map((paragraph, index) => (
          <p class:list={{ 'text-xl leading-relaxed text-base-content/85': index === 0, 'mt-4 leading-relaxed text-base-content/65': index > 0 }}>
            {paragraph}
          </p>
        ))}
      </div>
    </div>
  </div>
</section>
