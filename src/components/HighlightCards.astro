---
import { Briefcase, Droplet, Globe, MonitorSmartphone, Plus } from '@lucide/astro';

const iconComponents = {
  cakephp: Briefcase,
  frontend: MonitorSmartphone,
  opensource: Globe,
  drupal: Droplet,
};

interface Highlight {
  icon: string;
  title: string;
  description: string;
}

interface Props {
  highlights: Highlight[];
}

const { highlights } = Astro.props;
---

<div class="grid gap-6 md:grid-cols-2">
  {highlights.map((item, index) => {
    const Icon = iconComponents[item.icon as keyof typeof iconComponents] ?? Plus;
    return (
      <article class="highlight-card card border-2 border-base-content/20 bg-base-100 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-primary/45 hover:shadow-lg hover:shadow-base-content/10" style={`--highlight-index: ${index}; opacity: 0; transform: translateY(12px);`}>
        <div class="card-body">
          <div class="w-14 h-14 flex items-center justify-center mb-3">
            <Icon class="feature-card-icon h-8 w-8 text-base-content" strokeWidth={1.8} aria-hidden="true" />
          </div>
          <h3 class="card-title">{item.title}</h3>
          <p class="text-base-content/80">{item.description}</p>
        </div>
      </article>
    );
  })}
</div>
