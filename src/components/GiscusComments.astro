---
const locale = Astro.currentLocale ?? 'en';
---

<div data-giscus-comments data-lang={locale}></div>

<script>
  const container = document.querySelector<HTMLElement>('[data-giscus-comments]');

  if (container && container.dataset.initialized !== 'true') {
    container.dataset.initialized = 'true';

    const getGiscusTheme = () =>
      document.documentElement.dataset.theme === 'spring-night' ? 'dark' : 'light';

    const script = document.createElement('script');
    const settings = {
      repo: 'josbeir/personal-blog',
      'repo-id': 'R_kgDOLfQ6BA',
      category: 'Announcements',
      'category-id': 'DIC_kwDOLfQ6BM4CwBmN',
      mapping: 'pathname',
      strict: '0',
      'reactions-enabled': '1',
      'emit-metadata': '0',
      'input-position': 'bottom',
      theme: getGiscusTheme(),
      lang: container.dataset.lang ?? 'en',
    };

    script.src = 'https://giscus.app/client.js';
    script.async = true;
    script.crossOrigin = 'anonymous';

    Object.entries(settings).forEach(([key, value]) => {
      script.setAttribute(`data-${key}`, value);
    });

    container.appendChild(script);

    const syncGiscusTheme = () => {
      const frame = container.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
      frame?.contentWindow?.postMessage(
        { giscus: { setConfig: { theme: getGiscusTheme() } } },
        'https://giscus.app',
      );
    };

    const themeObserver = new MutationObserver(syncGiscusTheme);
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
  }
</script>
