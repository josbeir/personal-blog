---
import { ArrowUpRight, Code2, GitFork, Star } from '@lucide/astro';
import type { GitHubProject } from '../lib/github-projects';
import { t } from '../i18n/index';

interface Props {
  projects: GitHubProject[];
  profileUrl: string;
}

const { projects, profileUrl } = Astro.props;
const locale = Astro.currentLocale ?? 'en';
const projectGroups = [
  {
    title: t(locale, 'github_projects_cakephp'),
    projects: projects.filter((project) => project.name.startsWith('cakephp-')),
  },
  {
    title: t(locale, 'github_projects_other'),
    projects: projects.filter((project) => !project.name.startsWith('cakephp-')),
  },
].filter((group) => group.projects.length > 0);
---

<div>
  <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-center gap-3">
      <span class="flex h-10 w-10 items-center justify-center rounded-full bg-base-200 text-base-content">
        <Code2 class="h-5 w-5" strokeWidth={1.8} aria-hidden="true" />
      </span>
      <p class="text-sm text-base-content/65">{t(locale, 'github_projects_intro', { count: String(projects.length) })}</p>
    </div>
    <a class="btn btn-ghost btn-sm gap-1 self-start sm:self-auto" href={profileUrl} target="_blank" rel="noopener noreferrer">
      {t(locale, 'github_projects_profile')}
      <ArrowUpRight class="h-4 w-4" strokeWidth={1.8} aria-hidden="true" />
    </a>
  </div>

  {projects.length > 0 ? (
    <div class="space-y-10">
      {projectGroups.map((group) => (
        <section>
          <h3 class="mb-4 text-sm font-semibold uppercase tracking-[0.16em] text-base-content/60">{group.title}</h3>
          <ul class="grid gap-4 md:grid-cols-2">
            {group.projects.map((project) => (
              <li class="overflow-hidden rounded-box border border-base-content/10 shadow-sm">
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex h-full flex-col gap-5 bg-base-100 px-5 py-5 transition-colors hover:bg-base-200/75 sm:px-7"
                >
                  <div class="min-w-0">
                    <div class="flex items-center gap-2">
                      <h4 class="font-semibold tracking-tight text-base-content group-hover:text-primary">{project.name}</h4>
                      <ArrowUpRight class="h-4 w-4 shrink-0 text-base-content/40 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-primary" strokeWidth={1.8} aria-hidden="true" />
                    </div>
                    <p class="mt-1 text-sm leading-relaxed text-base-content/65">{project.description ?? t(locale, 'github_projects_no_description')}</p>
                  </div>

                  <div class="mt-auto flex items-center gap-3 text-xs text-base-content/55">
                    {project.language && <span class="badge badge-ghost badge-sm font-medium">{project.language}</span>}
                    {project.stars > 0 && <span class="flex items-center gap-1"><Star class="h-3.5 w-3.5" strokeWidth={1.8} aria-hidden="true" />{project.stars}</span>}
                    {project.forks > 0 && <span class="flex items-center gap-1"><GitFork class="h-3.5 w-3.5" strokeWidth={1.8} aria-hidden="true" />{project.forks}</span>}
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  ) : (
    <p class="py-8 text-sm text-base-content/65">{t(locale, 'github_projects_unavailable')}</p>
  )}
</div>
