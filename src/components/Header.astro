---
import { t, getSiteData } from '../i18n/index';
import { ChevronDown, Menu, Moon, Sun } from '@lucide/astro';

const locale = Astro.currentLocale ?? 'en';
const siteData = getSiteData(locale);
const currentLang = locale.toUpperCase();
const languages = [
  { code: 'en', label: 'English' },
  { code: 'nl', label: 'Nederlands' },
  { code: 'fr', label: 'Francais' },
];
---

<header class="border-b border-primary/15 bg-base-100/90 backdrop-blur supports-backdrop-filter:bg-base-100/70 sticky top-0 z-30">
  <div class="navbar max-w-7xl mx-auto px-2 sm:px-4 lg:px-8">
    <div class="navbar-start min-w-0">
      <label for="mobile-nav-drawer" class="btn btn-ghost btn-square btn-sm lg:hidden" aria-label={t(locale, 'open_menu')}>
        <Menu class="h-5 w-5" strokeWidth={2} aria-hidden="true" />
      </label>
      <a href={locale === 'en' ? '/' : `/${locale}/`} class="btn btn-ghost min-w-0 px-1 text-lg sm:px-2 sm:text-xl">
        <span class="truncate font-semibold">Jasper Smet</span>
      </a>
    </div>

    <div class="navbar-center hidden lg:flex">
      <ul class="menu menu-horizontal px-1 gap-1">
        {siteData.nav.map((item) => (
          <li>
            <a href={item.url}>{item.label}</a>
          </li>
        ))}
      </ul>
    </div>

    <div class="navbar-end">
      <div class="dropdown dropdown-end mr-1">
        <button type="button" class="btn btn-ghost btn-sm font-bold" aria-label="Language">
          {currentLang}
          <ChevronDown class="ml-0.5 h-3 w-3" strokeWidth={2.5} aria-hidden="true" />
        </button>
        <ul tabindex="0" class="dropdown-content menu p-2 shadow bg-base-100 border border-base-content/10 rounded-box w-36 z-50 mt-2">
          {languages.map((lang) => (
            <li>
              <a
                href={lang.code === 'en' ? '/' : `/${lang.code}/`}
                class:list={{ 'font-bold': lang.code === locale }}
              >
                {lang.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <button type="button" class="btn btn-ghost btn-circle btn-sm mr-1" data-theme-toggle aria-label={t(locale, 'toggle_theme')} aria-pressed="false">
        <Moon class="h-5 w-5" data-theme-icon="dark" strokeWidth={2} aria-hidden="true" />
        <Sun class="hidden h-5 w-5" data-theme-icon="light" strokeWidth={2} aria-hidden="true" />
      </button>
      <a href={locale === 'en' ? '/contact/' : `/${locale}/contact/`} class="btn btn-primary btn-sm lg:btn-md">
        {t(locale, 'get_in_touch')}
      </a>
    </div>
  </div>
</header>
