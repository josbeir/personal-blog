---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import PageIntro from '../components/PageIntro.astro';
import { getContactPageData } from '../i18n/index';

const locale = 'en';
const data = getContactPageData(locale);
---

<BaseLayout title={data.title} description={data.description}>
  <PageIntro {...data} />

  <section class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-start">
    <div>
      <h2 class="text-2xl font-semibold tracking-tight">{data.formTitle}</h2>
      <p class="mt-2 mb-6 max-w-2xl leading-relaxed text-base-content/70">{data.formDescription}</p>
      <ContactForm />
    </div>
    <aside class="rounded-box border border-base-content/10 bg-base-200 p-6 lg:sticky lg:top-24">
      <h2 class="font-semibold tracking-tight">{data.hintTitle}</h2>
      <p class="mt-3 leading-relaxed text-base-content/70">{data.hint}</p>
    </aside>
  </section>
</BaseLayout>
